{
    "name": "glimmerwing",
    "version": "1.0.0",
    "description": "Glimmerwing: a split-screen versus shooter for the browser (desktop, mobile, installable).",
    "scripts": {
        "dev": "npm run build && npm run server",
        "build": "npm run typecheck && node build.mjs",
        "server": "node dist/server.cjs",
        "typecheck": "tsc -p .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run typecheck:server && npm run lint && npm run format:check",
        "typecheck:server": "tsc -p server"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/express": "^5.0.3",
        "@types/node": "^22.10.0",
        "esbuild": "^0.21.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-jsdoc": "^50.8.0",
        "globals": "^15.15.0",
        "prettier": "^3.10.0",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.72.2"
    },
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "express": "^5.1.0",
        "mysql2": "^3.11.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.27"
    }
}
