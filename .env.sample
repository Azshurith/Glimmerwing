# Copy to .env (make project_setup does) and change the passwords.

# Docker Project
PROJECT_NAME=glimmerwing
PROJECT_VERSION=1.0

# Node Configurations (the game: page, API and online relay)
NODE_DOCKERFILE=.docker/Node
NODE_DIRECTORY=.
NODE_WORK_DIRECTORY=/var/glimmerwing
NODE_PORT=8787
# The online relay address baked into the page; leave empty to use the page's own host.
GW_SERVER=

# MariaDB Configurations
MARIADB_DOCKERFILE=.docker/MariaDB
MARIADB_HOST=mariadb
MARIADB_PORT=3307
MARIADB_DATABASE=glimmerwing
MARIADB_USERNAME=glimmerwing
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# PhpMyAdmin Configurations
PHPMYADMIN_DOCKERFILE=.docker/PhpMyAdmin
PHPMYADMIN_PORT=9091
PHPMYADMIN_PORT_MAP=80
PHPMYADMIN_PMA_HOST=mariadb
